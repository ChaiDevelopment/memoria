# MEMORA — server configuration.
# Local:      copy to .env.local and fill in.
# Cloudflare: set each one with `npx wrangler secret put <NAME>` (or in the dashboard).
# Never commit real values.

# Public URL of the app (used for the Google sign-in redirect and cookies).
# Local: http://localhost:3000  ·  Cloudflare: https://memora.<your-subdomain>.workers.dev
APP_URL=http://localhost:3000

# 32+ random bytes, base64. Signs the login cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Who may enter the museum (comma-separated Google accounts).
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com

# ── Google Cloud (the project you already use for Jadwal Piket works) ─────
# 1. APIs & Services → Library: enable "Google Drive API" and "Google Sheets API".
# 2. Credentials → Create credentials → OAuth client ID → Web application.
#      Authorized redirect URIs: <APP_URL>/api/auth/callback
#    (add one line per URL you use: localhost, ngrok, workers.dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 3. IAM & Admin → Service accounts → Create service account (no roles needed)
#    → Keys → Add key → JSON. From that JSON file copy:
#      "client_email" → GOOGLE_SERVICE_ACCOUNT_EMAIL
#      "private_key"  → GOOGLE_SERVICE_ACCOUNT_KEY (keep it in double quotes, \n included)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# 4. Share the photo folder in Google Drive with the service account email (Viewer).
#    Folder id = the last part of the folder URL: drive.google.com/drive/folders/<THIS>
DRIVE_FOLDER_ID=

# 5. Create an empty Google Sheet, share it with the service account email (Editor).
#    Sheet id = the part of the URL between /d/ and /edit
SHEET_ID=

# ── Multiplayer (presence server, see presence/) ─────────────────────────
# URL of the presence Worker (wss://… in production). Leave empty to stay solo.
# Local: run `npm run presence:dev`, then ws://127.0.0.1:8788
# The presence Worker needs the SAME SESSION_SECRET (secret on that Worker,
# or presence/.dev.vars locally).
PRESENCE_URL=
